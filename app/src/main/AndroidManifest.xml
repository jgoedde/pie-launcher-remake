<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- The App Drawer's Uninstall menu item hands off to the system uninstaller (ACTION_DELETE). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Without it getInstalledProviders() lists only system widget providers (PRD 7.1). -->
    <queries>
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
    </queries>

    <application
        android:name=".PieLauncherApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:theme="@style/Theme.PieLauncher">

        <activity
            android:name=".home.HomeActivity"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- "Wallpaper & style" finds the ThemePicker provider through these (PRD 8.4). -->
            <meta-data
                android:name="com.android.launcher3.themedicon.option"
                android:value="${applicationId}.themepicker" />
            <meta-data
                android:name="com.android.launcher3.grid.control"
                android:value="${applicationId}.themepicker" />
        </activity>

        <provider
            android:name=".icons.ThemePickerProvider"
            android:authorities="${applicationId}.themepicker"
            android:exported="true"
            android:permission="android.permission.BIND_WALLPAPER" />

        <!--
          Launcher Settings (PRD 10.1): its own LAUNCHER entry, so it shows in the App Drawer, can be
          a Pie Item and stays reachable when the Pie Config is broken. Own task, so it never
          lands in the Home Activity's task.
        -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:label="@string/settings_label"
            android:taskAffinity="${applicationId}.settings"
            android:theme="@style/Theme.PieLauncher.Settings">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pin Requests (e.g. browser PWAs): accepted silently, see PinShortcutActivity. -->
        <activity
            android:name=".drawer.PinShortcutActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>

        <!-- The Widget Picker (ADR 0006, PRD 7.4): a bottom sheet over Home. -->
        <activity
            android:name=".widgets.WidgetPickerActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.PieLauncher.Trampoline"
            android:windowSoftInputMode="adjustResize" />

        <!-- The widget-add trampoline (PRD 7.4): bind and configure results land here. -->
        <activity
            android:name=".widgets.AddWidgetActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.PieLauncher.Trampoline" />

        <!-- App-initiated widget pinning (requestPinAppWidget, PRD 7.6): a confirmation sheet. -->
        <activity
            android:name=".widgets.PinWidgetActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.PieLauncher.Trampoline">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_APPWIDGET" />
            </intent-filter>
        </activity>
    </application>
</manifest>
