{
  "$schema": "https://raw.githubusercontent.com/jgoedde/pie-launcher-remake/main/spec/pie-config.schema.json",
  "version": 1,
  "baseLayer": "home",
  "layers": [
    {
      "id": "home",
      "name": "Home",
      "color": "primary",
      "items": [
        { "type": "app", "package": "com.android.dialer" },
        { "type": "app", "package": "app.grapheneos.camera" },
        { "type": "app", "package": "org.mozilla.firefox" },
        { "type": "shortcut", "package": "org.mozilla.firefox", "shortcutId": "https://app.example.org/" },
        { "type": "app", "package": "md.obsidian" },
        { "type": "layer", "layer": "media" },
        { "type": "layer", "layer": "tools" }
      ]
    },
    {
      "id": "media",
      "name": "Media",
      "color": "#E8A33D",
      "icon": "music_note",
      "items": [
        { "type": "app", "package": "app.alextran.immich" },
        { "type": "app", "package": "app.revanced.android.apps.youtube.music" },
        { "type": "shortcut", "package": "app.vanadium.browser", "shortcutId": "3f2c9a4e-7b1d-4c5e-9f0a-2d6b8e1c4a73" },
        { "type": "layer", "layer": "home" }
      ]
    },
    {
      "id": "tools",
      "name": "Tools",
      "color": "tertiary",
      "icon": "build",
      "items": [
        { "type": "app", "package": "me.zhanghai.android.files" },
        { "type": "app", "package": "com.google.android.deskclock" },
        { "type": "app", "package": "com.android.settings", "activity": "com.android.settings.Settings" },
        { "type": "layer", "layer": "home" }
      ]
    }
  ]
}
